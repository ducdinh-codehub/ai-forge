Screen { background: $background; }

.section-title { text-style: bold; color: $accent; height: auto; margin: 1 0 0 0; }
.hint { color: $text-muted; height: auto; margin-bottom: 1; }
.error { color: $error; height: auto; }
.toolbar { height: auto; margin: 1 0 0 0; }
.toolbar Button { margin-right: 1; min-width: 8; }
.spacer { width: 1fr; }
.input-row { height: auto; }
.input-row Input { width: 1fr; }
.input-row Button { margin-left: 1; }

/* Home ------------------------------------------------------------------- */
#banner { margin: 1 0 0 0; border-bottom: hkey $panel; height: 9; }
#library { width: 1fr; padding: 0 1; }
#models { height: 1fr; }
#details-pane { width: 72; padding: 0 1; border-left: tall $panel; }
/* 8 actions don't fit one row of the 72-column pane: two rows of 4 */
#details-pane > .toolbar { layout: grid; grid-size: 4; grid-rows: 3; grid-gutter: 0 1; height: auto; }
#details-pane > .toolbar Button { width: 100%; margin-right: 0; }
#details { height: 1fr; margin-top: 1; }
#details-text { width: 100%; }
#empty-hint { height: 1fr; content-align: center middle; text-align: center; color: $text-muted; background: $boost; }

/* Builder ---------------------------------------------------------------- */
#palette-pane { width: 27; padding: 0 1; border-right: tall $panel; }
#palette { height: 1fr; }
#palette-help { height: 6; color: $text-muted; padding-top: 1; }
#stack-pane { width: 1fr; padding: 0 1; }
#stack { height: 1fr; }
#totals { height: auto; margin-top: 1; padding: 0 1; background: $boost; }
#side-tabs { width: 40; border-left: tall $panel; }
#side-tabs TabPane { padding: 0; }
#props { padding: 0 1; }
#explain-scroll { padding: 0 1; }
#explain { margin: 0; }
#props Label { margin-top: 1; }
#m-dims { height: auto; }
#m-dims > Vertical { width: 1fr; height: auto; }
#m-dims Label { color: $text-muted; }
#layer-io { background: $boost; padding: 0 1; height: auto; margin-bottom: 1; }

/* Train ------------------------------------------------------------------ */
#train-config { width: 52; padding: 0 1; border-right: tall $panel; }
#train-config Label { margin-top: 1; }
#train-config .row { height: auto; }
#train-config .row > Vertical { height: auto; width: 1fr; margin-right: 1; }
#train-config .group { height: auto; }
#train-config .path-row { height: auto; }
#train-config .path-row Input { width: 1fr; }
#train-config #load { margin-top: 1; width: 100%; }
#train-config .switch-row { height: auto; margin-top: 1; }
#train-config .switch-row Label { margin: 1 0 0 1; }
#freeze { height: auto; max-height: 14; }
#train-status { width: 1fr; padding: 0 1; }
#data-info { height: auto; margin-top: 1; }
#fit-row { height: auto; margin-top: 1; }
#mismatch { width: 1fr; height: auto; padding: 0 0 0 2; }
#epoch-label { width: 1fr; padding-top: 1; color: $text-muted; }
#progress { margin: 1 0; }
#charts { height: 12; }
#charts LineChart { width: 1fr; height: 12; margin-right: 2; }
#log { height: 1fr; border: round $panel; }

/* Predict / Export --------------------------------------------------------- */
#predict, #export { padding: 0 2; }
#result { height: auto; margin: 1 0; padding: 1 2; background: $boost; min-height: 3; }
#predict-log, #export-log { height: 1fr; border: round $panel; margin-top: 1; }
#formats { height: auto; max-height: 12; }

/* Guide ------------------------------------------------------------------ */
#guide-nav-pane { width: 34; padding: 0 1; border-right: tall $panel; }
#guide-nav { height: 1fr; }
#guide-body { width: 1fr; padding: 0 2; }

/* Training guide drawer ---------------------------------------------------- */
#train-main { layers: base drawer; }
#guide-drawer {
    layer: drawer; dock: right; width: 46%; min-width: 40; height: 100%;
    background: $surface; padding: 0 1 0 0; display: none;
}
#drawer-head { height: auto; margin-top: 1; padding-left: 1; }
#drawer-topics, #drawer-body { margin-left: 1; }
#drawer-title { width: 1fr; text-style: bold; color: $accent; padding-top: 1; }
#drawer-head Button { margin-left: 1; min-width: 5; }
#drawer-topics { height: auto; max-height: 12; margin-top: 1; }
#drawer-body { height: 1fr; margin-top: 1; }

/* Dataset hub -------------------------------------------------------------- */
#hub-nav-pane { width: 46; padding: 0 1; border-right: tall $panel; }
#hub-list { height: 1fr; }
#hub-detail-pane { width: 1fr; padding: 0 1 1 2; }
#hub-body { height: 1fr; }
#hub-status { height: auto; margin-top: 1; }
#hub-progress { margin-top: 1; }
#train-config #hub { margin-top: 1; width: 100%; }

/* Evaluate ----------------------------------------------------------------- */
#eval-config { width: 52; padding: 0 1; border-right: tall $panel; }
#eval-config Label { margin-top: 1; }
#eval-config .group { height: auto; }
#eval-config .path-row { height: auto; }
#eval-config .path-row Input { width: 1fr; }
#eval-config .switch-row { height: auto; margin-top: 1; }
#eval-config .switch-row Label { margin: 1 0 0 1; }
#eval-config Button { width: 100%; margin-top: 1; }
#eval-config .path-row Button { width: auto; margin-top: 0; }
#eval-history { margin-top: 1; }
#eval-result { width: 1fr; padding: 0 1; }
#eval-status { height: auto; }
#eval-progress { margin: 1 0 0 0; }
#eval-body { height: 1fr; margin-top: 1; }
